# Copy to .env.selfhost, fill in, then: chmod 600 .env.selfhost
# Never commit the filled-in file.

# openssl rand -hex 24   (hex: safe inside the connection URL)
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=tvwh2k

# openssl rand -hex 32   (used by GoTrue AND the Go API; same value; also the
# JWT secret the frontend/API verify HS256 tokens with)
SUPABASE_JWT_SECRET=CHANGE_ME

# openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME

# Public hostnames (tunnel public hostnames, both -> http://caddy:80)
AUTH_HOST=auth.example.com
API_HOST=api.example.com
# GoTrue public URL (no /auth/v1 suffix; Caddy maps it). Frontend VITE_SUPABASE_URL = this value.
API_EXTERNAL_URL=https://auth.example.com
# Where users land after email links; the frontend origin.
SITE_URL=https://app.example.com
GOTRUE_URI_ALLOW_LIST=
API_BASE_URL=https://api.example.com
FRONTEND_ORIGIN=https://app.example.com

# Secure defaults: signup closed, email confirmation required (needs SMTP below).
# First account: set GOTRUE_DISABLE_SIGNUP=false (and AUTOCONFIRM=true without SMTP),
# start, sign up, then set them back and restart.
GOTRUE_DISABLE_SIGNUP=true
GOTRUE_MAILER_AUTOCONFIRM=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=

# Keep true until you intentionally go live.
KRAKEN_TEST_MODE=true
WEBHOOK_TRUST_PROXY=true
# Proxies appending to X-Forwarded-For (cloudflared -> caddy = 2); CF-Connecting-IP is preferred.
WEBHOOK_TRUSTED_HOPS=2

# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

# backup.sh
BACKUP_DIR=/volume1/backups/tvwh2k
BACKUP_RETENTION_DAYS=14
