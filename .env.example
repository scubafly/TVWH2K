# Postgres connection string for your Supabase project (Project Settings -> Database).
DATABASE_URL=postgres://postgres:password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Supabase project JWT secret (Project Settings -> API -> JWT Secret), used to
# verify the Authorization: Bearer <token> header the frontend sends.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# 32-byte key, base64-encoded, used to encrypt Kraken/Telegram credentials at
# rest. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-openssl-rand--base64-32-output

# Public base URL of this backend, used to build the per-connection webhook
# URLs shown to users (e.g. https://api.tradingbridge.online).
API_BASE_URL=http://localhost:8081

# Origin of the frontend app, allowed via CORS for /api/* routes.
FRONTEND_ORIGIN=http://localhost:8080

# Server-wide kill-switch. Anything other than "false" keeps all Kraken orders
# validate-only (dry-run). Set to false to execute real orders.
KRAKEN_TEST_MODE=true

PORT=8081

# Webhook hardening (all optional; defaults shown).
# Token-bucket rate limits: sustained requests/minute and burst size.
# WEBHOOK_TOKEN_RATE_PER_MIN=30
# WEBHOOK_TOKEN_BURST=10
# WEBHOOK_IP_RATE_PER_MIN=120
# WEBHOOK_IP_BURST=30
# Identical payload (or same idempotency_id) per token inside this window is
# ignored with {"status":"duplicate"}. 0 disables.
# WEBHOOK_DEDUP_WINDOW=60s
# Max request body size in bytes (413 above this).
# WEBHOOK_MAX_BODY_BYTES=16384
# Max order volume accepted (base units); larger gets 400.
# WEBHOOK_MAX_VOLUME=1000000
# Set true only behind a trusted reverse proxy: client IP = last X-Forwarded-For hop.
# WEBHOOK_TRUST_PROXY=false
# Proxies appending to X-Forwarded-For when TRUST_PROXY=true (cloudflared -> caddy = 2).
# CF-Connecting-IP is preferred when it is a valid IP.
# WEBHOOK_TRUSTED_HOPS=2

# Own-account SPOT DCA runner (off by default; see README).
# Known limitation: cooldown is in-memory unless DCA_STATE_FILE is set. Overlaps with tribot cmd/portfolio.
# DCA_ENABLED=false
# Live orders only if KRAKEN_TEST_MODE=false AND DCA_LIVE=true (else validate-only).
# DCA_LIVE=false
# DCA_THRESHOLD=-10.0
# DCA_AMOUNT_EUR=25
# DCA_COOLDOWN_HOURS=24
# DCA_MIN_VALUE_EUR=5
# DCA_INTERVAL_MINUTES=5
# Max EUR placed per UTC day (default 3x DCA_AMOUNT_EUR, 0 disables).
# DCA_MAX_DAILY_EUR=75
# Persist cooldown + daily spend across restarts (empty = memory only).
# DCA_STATE_FILE=/data/dca-state.json
# KRAKEN_API_KEY=
# KRAKEN_API_SECRET=
