# Postgres connection string for your Supabase project (Project Settings -> Database).
DATABASE_URL=postgres://postgres:password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Supabase project JWT secret (Project Settings -> API -> JWT Secret), used to
# verify the Authorization: Bearer <token> header the frontend sends.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# 32-byte key, base64-encoded, used to encrypt Kraken/Telegram credentials at
# rest. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-openssl-rand--base64-32-output

# Public base URL of this backend, used to build the per-connection webhook
# URLs shown to users (e.g. https://api.tradingbridge.online).
API_BASE_URL=http://localhost:8081

# Origin of the frontend app, allowed via CORS for /api/* routes.
FRONTEND_ORIGIN=http://localhost:8080

PORT=8081
